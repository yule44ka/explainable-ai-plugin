<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.example.explainable-ai-plugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Explainable-ai-plugin</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.yourcompany.com">YourCompany</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Enter short description for your plugin here.<br>
        <em>most HTML tags may be used</em>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="AI assistant"
                    stripeTitle="AI assistant"
                    anchor="right"
                    factoryClass="com.example.explainableaiplugin.MyToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
        
        <!-- Settings -->
        <projectConfigurable 
            parentId="tools"
            instance="com.example.explainableaiplugin.settings.OpenAISettingsConfigurable"
            id="com.example.explainableaiplugin.settings.OpenAISettingsConfigurable"
            displayName="Explainable AI"/>
        
        <!-- Services -->
        <projectService serviceImplementation="com.example.explainableaiplugin.services.OpenAIService"/>
        <projectService serviceImplementation="com.example.explainableaiplugin.services.ExplanationCommentInserter"/>
        
        <!-- Notification Group -->
        <notificationGroup id="Explainable AI" displayType="BALLOON"/>
    </extensions>
    
    <!-- Actions -->
    <actions>
        <group id="ExplainableAI.EditorPopupMenu" text="AI Assistant" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            
            <action id="ExplainableAI.ExplainCode"
                    class="com.example.explainableaiplugin.actions.ExplainCodeAction"
                    text="Explain Code"
                    description="Explain selected code using AI"
                    icon="AllIcons.Actions.IntentionBulb"/>
            
            <action id="ExplainableAI.AnalyzeCode"
                    class="com.example.explainableaiplugin.actions.AnalyzeCodeAction"
                    text="Analyze Code"
                    description="Analyze selected code for issues"
                    icon="AllIcons.Actions.InspectCode"/>
            
            <action id="ExplainableAI.GenerateSummary"
                    class="com.example.explainableaiplugin.actions.GenerateSummaryAction"
                    text="Generate Summary"
                    description="Generate multi-level summary of selected code"
                    icon="AllIcons.Actions.Preview"/>

            <action id="ExplainableAI.AddExplanationComments"
                    class="com.example.explainableaiplugin.actions.AddExplanationCommentsAction"
                    text="Add Explanation Comments"
                    description="Generate high-detail bullet explanations and insert them as comments before mapped code chunks"
                    icon="AllIcons.Actions.Annotate"/>
        </group>
    </actions>
</idea-plugin>
